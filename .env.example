# Copy this file to .env.local and fill in your Supabase project's values
# to switch the app from local demo mode to a real backend.
#
# Both variables are required together — if either is missing, the app
# falls back to local demo mode automatically (see src/lib/supabase/env.ts).
#
# Found in your Supabase project dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add a service-role key here. The app is designed to never need one
# in the frontend — all privileged writes go through Postgres functions
# (see supabase/migrations) protected by Row Level Security instead.
